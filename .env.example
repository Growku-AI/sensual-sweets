# Sensual Sweets — environment variables
#
# Copy this file to `.env.local` and fill in the values for local dev.
# In production these are set on Dokploy (app: WDwlwU7kWhafiStbm6UN9).
#
# NOTE: NEXT_PUBLIC_* vars are inlined at build time. Changing them on
# Dokploy requires a fresh build (auto-deploy on push to `main` will pick
# them up automatically).

# Shopify Storefront API ------------------------------------------------------

# Your shop's .myshopify.com domain (without https://, no trailing slash).
NEXT_PUBLIC_SHOPIFY_DOMAIN=

# Public Storefront API access token from the Headless sales channel.
# Browser-safe. Required.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Optional: private Storefront API access token (also from the Headless channel).
# Server-side only — do not prefix with NEXT_PUBLIC_. Use for elevated reads
# (e.g. unpublished products) or rate-limit headroom on server actions.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
